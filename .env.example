# ============================================================
# CareerAI — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git!
# ============================================================

# ── Groq API Key ───────────────────────────────────────────
# Get a FREE key at: https://console.groq.com
# Free tier: 14,400 requests/day on llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key_here

# ── Database ───────────────────────────────────────────────
# PostgreSQL (Neon.tech free tier) for production.
# Leave commented out to use SQLite locally.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── JWT Secret Key ─────────────────────────────────────────
# Generate a strong random key for production:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-in-production

# ── CORS ───────────────────────────────────────────────────
# Comma-separated origins. Use * for development.
# ALLOWED_ORIGINS=https://your-app.onrender.com,https://your-domain.com
